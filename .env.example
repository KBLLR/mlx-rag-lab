# mlx-RAG environment template.
# Copy to .env and fill in only what you want to override:
#   cp .env.example .env
# Every value below is intentionally empty. Do not commit .env.
# All variables are optional; the code uses the fallback named in each comment.

# =============================================================================
# RAG API (src/rag/config/settings.py loads these from the environment and .env)
# =============================================================================

# Optional. Directory where knowledge-bank vector indexes are stored.
# Feature: RAG API index storage. Where: a local path you choose.
# If empty, the API uses var/indexes.
INDEX_ROOT_PATH=

# Optional. Embedding model id or a local model directory.
# Feature: RAG embeddings. Where: a public Hugging Face model id
# (https://huggingface.co) or a folder already on disk.
# If empty, the API uses sentence-transformers/all-MiniLM-L6-v2.
EMBEDDING_MODEL_ID=

# Optional. How many knowledge banks to keep loaded at once (integer, 1-50).
# Feature: RAG index cache. Where: choose a number for this machine.
# If empty, the API uses 3.
MAX_INDEX_CACHE_SIZE=

# Optional. Default chunk size in tokens (integer, 50-2048).
# Feature: RAG document chunking. Where: choose a size for this corpus.
# If empty, the API uses 256.
CHUNK_SIZE=

# Optional. Default overlap between chunks in tokens (integer, 0-512).
# Feature: RAG document chunking. Where: choose an overlap for this corpus.
# If empty, the API uses 50.
CHUNK_OVERLAP=

# Optional. Log verbosity: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
# Feature: RAG API logging. Where: choose a level locally.
# If empty, the API uses INFO.
LOG_LEVEL=

# Optional. Interface the API binds to.
# Feature: RAG API server. Where: 127.0.0.1 for this machine only, or
# 0.0.0.0 to accept other interfaces. If empty, the API uses 0.0.0.0.
API_HOST=

# Optional. TCP port for the RAG API (integer, 1024-65535).
# Feature: RAG API server. Where: an unused local port.
# If empty, the API uses 8000.
API_PORT=

# =============================================================================
# QA dataset generation (experiments/dataset_generation/generate_qa_dataset.py)
# =============================================================================

# Optional. MLX model id used to write questions.
# Feature: generated QA datasets. Where: a public Hugging Face MLX model id.
# If empty, the script uses mlx-community/mistral-7b-instruct-v0.2-4bit.
MLX_QUESTION_MODEL=

# Optional. MLX model id used to write answers.
# Feature: generated QA datasets. Where: a public Hugging Face MLX model id.
# If empty, the script uses mlx-community/mistral-7b-instruct-v0.2-4bit.
MLX_ANSWER_MODEL=

# Optional. Max tokens for a generated question (integer).
# Feature: generated QA datasets. Where: choose a limit locally.
# If empty, the script uses 160.
QUESTION_MAX_TOKENS=

# Optional. Max tokens for a generated answer (integer).
# Feature: generated QA datasets. Where: choose a limit locally.
# If empty, the script uses 256.
ANSWER_MAX_TOKENS=

# Optional. Maximum question/answer pairs per source document (integer).
# Feature: generated QA datasets. Where: choose a cap locally.
# If empty, the script uses 20.
MAX_QA_PER_DOC=

# Optional. Drop extracted chunks shorter than this many characters (integer).
# Feature: generated QA datasets. Where: choose a floor locally.
# If empty, the script uses 80.
MIN_CHARS_PER_CHUNK=

# Optional. Print generation debug lines when set to 1.
# Feature: generated QA datasets. Where: set 1 or 0 locally.
# If empty, the script treats debug as on (1).
QA_DEBUG=

# =============================================================================
# Local model files and Hugging Face cache
# =============================================================================

# Optional. Directory that holds downloaded MLX weight folders.
# Feature: model cleanup, manifests, and Flux benchmarks
# (scripts/clean_models.py, scripts/model_manifest.py, benchmarks/).
# Where: a local directory. If empty, those tools use ./mlx-models.
MLX_MODELS_DIR=

# Optional. Set to 1 only when you want a profiling run to re-download
# Flux weights from Hugging Face instead of using the local copy.
# Feature: Flux weight loading. Flux benchmarks clear this variable so a
# timed run stays on local files (benchmarks/flux_benchmark.py and related).
# Where: you choose the flag; it is not issued by a provider.
# If empty, downloads are not forced.
MLX_PROFILE_FORCE_DOWNLOAD=

# Optional. Hugging Face home directory for caches and tokens files.
# Feature: RAG package startup (src/rag/__init__.py) and `clean_models.py hf`.
# Where: a local directory. If empty, the package uses mlx-models/.hf-cache.
HF_HOME=

# Optional. Hugging Face Hub cache directory.
# Feature: RAG package startup (src/rag/__init__.py).
# Where: a local directory. If empty, the package uses mlx-models/.hf-cache.
HF_HUB_CACHE=

# Optional. Set to 1 to hide Hugging Face download progress bars.
# Feature: RAG package startup, to keep CLI output quiet.
# Where: you choose the flag. If empty, the package sets 1.
HF_HUB_DISABLE_PROGRESS_BARS=

# Optional. Set to 1 to disable the Hugging Face multiprocessing downloader.
# Feature: RAG package startup, avoiding a macOS/Python 3.12 fork crash.
# Where: you choose the flag. If empty, the package sets 1.
HF_HUB_DISABLE_MULTIPROCESSING=

# =============================================================================
# RAG health dashboard and contract checks
# (scripts/rag_health_dashboard.py, scripts/test_rag_contracts.py)
# =============================================================================

# Optional. Base URL of a running RAG API.
# Feature: health dashboard and contract checks.
# Where: the server you started (for example the local uvicorn process).
# If empty, those scripts use http://localhost:8000.
RAG_API_BASE_URL=

# Optional. Knowledge-bank name to query or display.
# Feature: health dashboard and contract checks.
# Where: the bank name you created in the index directory.
# If empty, those scripts use default.
RAG_API_BANK=

# Optional. HTTP timeout in seconds.
# Feature: health dashboard and contract checks.
# Where: choose a number for this machine. If empty, those scripts use 15.
RAG_API_TIMEOUT=

# Optional. Sample question sent by the contract check.
# Feature: scripts/test_rag_contracts.py. Where: any plain question you want
# to send. If empty, the script uses "How does MLX handle embeddings?".
RAG_API_CONTRACT_QUERY=

# Optional. Dashboard redraw interval in seconds. Checked before
# RAG_HEALTH_REFRESH. Feature: scripts/rag_health_dashboard.py.
# Where: choose a number locally. If both refresh variables are empty, the
# dashboard uses 5.
RAG_DASHBOARD_REFRESH=

# Optional. Fallback dashboard redraw interval in seconds, used only when
# RAG_DASHBOARD_REFRESH is empty. Feature: scripts/rag_health_dashboard.py.
# Where: choose a number locally.
RAG_HEALTH_REFRESH=

# =============================================================================
# Process launchers
# =============================================================================

# Optional. Import path prepended by the CLI entrypoints and app launchers
# (src/rag/cli/entrypoints.py, src/rag/cli/app_launcher.py, apps/flux_cli.py).
# Where: extra local directories, separated by the platform path separator.
# If empty, the launchers add this repo's src directory themselves.
PYTHONPATH=

# Optional. Hugging Face tokenizers thread pool switch (true or false).
# Feature: voice chat and speech-to-speech avatar
# (apps/voice_chat_cli.py, apps/sts_avatar_cli.py).
# Where: set false to silence the tokenizers fork warning.
# If empty, those apps set false.
TOKENIZERS_PARALLELISM=
