# MLX RAG Engine Configuration
# Copy this file to .env and customize as needed

# =============================================================================
# Vector Index Storage
# =============================================================================
# Root directory where vector indexes (knowledge banks) are stored
# Each bank creates a subdirectory: {INDEX_ROOT_PATH}/{bank_name}/vdb.npz
INDEX_ROOT_PATH=var/indexes

# =============================================================================
# Embedding Model Configuration
# =============================================================================
# HuggingFace model ID or local path for generating embeddings
# Default uses sentence-transformers compatible with MLX
# Examples:
#   - sentence-transformers/all-MiniLM-L6-v2 (default, 384 dims)
#   - sentence-transformers/all-mpnet-base-v2 (768 dims, better quality)
#   - /path/to/local/model (for offline deployments)
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2

# =============================================================================
# Index Cache Management
# =============================================================================
# Maximum number of knowledge banks to keep loaded in GPU memory simultaneously
# Higher values use more VRAM but reduce load times for frequently accessed banks
# Typical values: 3-10 depending on available VRAM
MAX_INDEX_CACHE_SIZE=3

# =============================================================================
# Chunking Configuration
# =============================================================================
# Default chunk size in tokens (can be overridden per upsert request)
# Larger chunks preserve more context but reduce retrieval precision
# Typical values: 128-512
CHUNK_SIZE=256

# Default overlap between consecutive chunks in tokens
# Higher overlap improves context continuity at cost of index size
# Typical values: 20-100 (10-40% of chunk size)
CHUNK_OVERLAP=50

# =============================================================================
# Logging Configuration
# =============================================================================
# Logging verbosity level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# API Server Configuration
# =============================================================================
# Host address to bind API server
# Use 0.0.0.0 to accept connections from any interface
# Use 127.0.0.1 for localhost-only access
API_HOST=0.0.0.0

# Port for API server
# Must be available and not in use by other services
API_PORT=8000
